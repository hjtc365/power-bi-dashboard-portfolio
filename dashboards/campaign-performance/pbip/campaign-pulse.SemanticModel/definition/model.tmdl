model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup DataSources

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Dimension Tables'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["_DataSources","Marketing_Data_Source","Marketing_Data_Dictionary","Fact_ProductSpend","Fact_ChannelPurchases","Fact_CampaignResponse","Dim_Product","Dim_Channel","Dim_Campaign","Dim_Customer","_Data_Quality_Issues"]

