table 'Format Switcher'
	lineageTag: bdc78455-3721-45ed-986c-3c778ccc2867

	/// Format switching calculation group
	calculationGroup
		precedence: 5

		/// Default format from the measure
		calculationItem Default = SELECTEDMEASURE()

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		/// Integer number format
		calculationItem Integer = SELECTEDMEASURE()

			formatStringDefinition = "#,##0"

		/// One decimal place
		calculationItem Decimal = SELECTEDMEASURE()

			formatStringDefinition = "#,##0.0"

		/// Percentage format
		calculationItem Percentage = SELECTEDMEASURE()

			formatStringDefinition = "#,##0.0%"

	column 'Format Switcher'
		dataType: string
		lineageTag: b7acb12a-acd2-4dda-8242-6cec2386172b

	partition 'Partition_Format Switcher' = calculationGroup

