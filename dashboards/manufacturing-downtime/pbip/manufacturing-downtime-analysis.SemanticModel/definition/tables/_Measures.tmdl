table _Measures
	lineageTag: 2212bf32-62b2-4a5b-b99d-89f3a27c0994

	/// Total number of batches produced
	measure 'Total Batches' =
			
			COUNTROWS ( Fact_Productivity )
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: e776d241-d8ed-4426-98f7-6b4136b99814

	/// Total downtime minutes across all batches and factors
	measure 'Total Downtime Minutes' =
			
			SUM ( Fact_Downtime[Downtime Minutes] )
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: 6699a546-ae49-405b-a169-592df0906305

	/// Total actual production time in minutes
	measure 'Total Actual Duration Minutes' =
			
			SUM ( Fact_Productivity[Actual Duration Minutes] )
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: b9053fff-be6f-4f93-8088-3f4049dd8c83

	/// Total minimum batch time target in minutes (no downtime scenario)
	measure 'Total Min Batch Time' =
			
			SUM ( Fact_Productivity[Min Batch Time] )
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: b9349a8d-96d0-4396-8bc0-d13cf1a51882

	/// Total minutes over the minimum batch time target
	measure 'Total Over Target Minutes' =
			
			SUM ( Fact_Productivity[Over Target Minutes] )
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: 83a44f23-9e51-4d1c-b9a1-82b321d49fc4

	/// Average actual batch duration in minutes
	measure 'Avg Batch Duration Minutes' =
			
			DIVIDE ( [Total Actual Duration Minutes], [Total Batches], 0 )
		formatString: #,##0.0
		displayFolder: 📊 Core Metrics
		lineageTag: bf262828-52da-4cf7-bfd2-b3b24c5464b9

	/// Average downtime per batch in minutes
	measure 'Avg Downtime Per Batch' =
			
			DIVIDE ( [Total Downtime Minutes], [Total Batches], 0 )
		formatString: #,##0.0
		displayFolder: 📊 Core Metrics
		lineageTag: ced7df0e-15e4-4df3-9d90-5fdcd1af9b99

	/// Batch efficiency: minimum target time as a percentage of actual time. Higher is better.
	measure 'Batch Efficiency %' =
			
			DIVIDE ( [Total Min Batch Time], [Total Actual Duration Minutes], 0 )
		formatString: #,##0.0%
		displayFolder: 📈 Rates & Ratios
		lineageTag: dc335c3a-4325-400f-8275-8498daf05c8f

	/// Downtime as a percentage of total actual production time
	measure 'Downtime Rate %' =
			
			DIVIDE ( [Total Downtime Minutes], [Total Actual Duration Minutes], 0 )
		formatString: #,##0.0%
		displayFolder: 📈 Rates & Ratios
		lineageTag: a9741b8e-8e12-4cbe-ab65-bdeeb016aa95

	/// Downtime minutes caused by operator error factors only
	measure 'Operator Error Downtime Minutes' =
			
			CALCULATE (
			    [Total Downtime Minutes],
			    Dim_DowntimeFactor[Operator Error] = "Yes"
			)
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: 8f3aef1f-cd96-458a-b5df-c0429438315d

	/// Operator error downtime as a percentage of total downtime minutes
	measure 'Operator Error Downtime %' =
			
			DIVIDE ( [Operator Error Downtime Minutes], [Total Downtime Minutes], 0 )
		formatString: #,##0.0%
		displayFolder: 📈 Rates & Ratios
		lineageTag: 0de4d18d-0986-4ee9-9207-79509ddb514f

	/// Downtime minutes not caused by operator error (machine/process related)
	measure 'Machine Downtime Minutes' =
			
			CALCULATE (
			    [Total Downtime Minutes],
			    Dim_DowntimeFactor[Operator Error] = "No"
			)
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: 8127f8be-eb2d-4590-8db9-359013276398

	/// Number of downtime incidents (unique batch-factor combinations)
	measure 'Total Downtime Incidents' =
			
			COUNTROWS ( Fact_Downtime )
		formatString: #,##0
		displayFolder: 📊 Core Metrics
		lineageTag: bd4f530c-7ed6-4c58-bdf6-fe859155b8e3

	/// Rank of operator by total downtime minutes — 1 is highest downtime
	measure 'Operator Downtime Rank' =
			
			RANKX ( ALL ( Dim_Operator[Operator] ), [Total Downtime Minutes],, DESC, DENSE )
		formatString: #,##0
		displayFolder: 🔢 Ranking
		lineageTag: aae2bc7b-6035-479c-962f-fea7fcf3edc8

	/// Rank of downtime factor by total minutes — 1 is most impactful factor
	measure 'Factor Downtime Rank' =
			
			RANKX (
			    ALL ( Dim_DowntimeFactor[Description] ),
			    [Total Downtime Minutes],
			    ,
			    DESC,
			    DENSE
			)
		formatString: #,##0
		displayFolder: 🔢 Ranking
		lineageTag: bf1d27b5-f202-4cd1-bbfe-d709a95aa346

	/// Operator's share of total downtime minutes across all operators
	measure 'Operator Downtime Share %' =
			
			DIVIDE (
			    [Total Downtime Minutes],
			    CALCULATE ( [Total Downtime Minutes], ALL ( Dim_Operator ) ),
			    0
			)
		formatString: #,##0.0%
		displayFolder: 📈 Rates & Ratios
		lineageTag: 0988ebd5-de9e-447d-9eee-be9d36c15d1c

	/// Factor's share of total downtime minutes across all factors
	measure 'Factor Downtime Share %' =
			
			DIVIDE (
			    [Total Downtime Minutes],
			    CALCULATE ( [Total Downtime Minutes], ALL ( Dim_DowntimeFactor ) ),
			    0
			)
		formatString: #,##0.0%
		displayFolder: 📈 Rates & Ratios
		lineageTag: 046c075f-aa35-4e07-8fab-79eb627493a1

	/// Timestamp of the most recent data refresh
	measure 'Last Refresh' =
			
			"Last Refresh: " & FORMAT ( NOW (), "MMM DD, YYYY h:mm AM/PM" )
		displayFolder: 🔧 Utility
		lineageTag: edcecf05-3639-4eb3-96ea-78b7c004c3df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total number of rows loaded in Fact_Productivity
	measure 'Fact Productivity Row Count' =
			
			COUNTROWS ( Fact_Productivity )
		formatString: #,##0
		displayFolder: 🔧 Utility
		lineageTag: 60ec33bd-3c7b-4fd2-a6c7-6d3224ff50d0

	/// Total number of rows loaded in Fact_Downtime
	measure 'Fact Downtime Row Count' =
			
			COUNTROWS ( Fact_Downtime )
		formatString: #,##0
		displayFolder: 🔧 Utility
		lineageTag: c88d15fa-f86a-4a28-aabd-ac71e7a5ab72

	/// Selected value from the Top N slicer — defaults to 5
	measure 'Top N Value' =
			
			SELECTEDVALUE ( 'Top N'[Top N], 5 )
		formatString: #,##0
		displayFolder: ⚙️ What-If
		lineageTag: 00c3d77a-6390-4e0f-96c5-e19075afbf90

	/// Total downtime minutes visible only for the top N downtime factors
	measure 'Top N Factor Downtime' =
			
			VAR _n =
			    SELECTEDVALUE ( 'Top N'[Top N], 5 )
			RETURN
			    IF ( [Factor Downtime Rank] <= _n, [Total Downtime Minutes], BLANK () )
		formatString: #,##0
		displayFolder: 🔢 Ranking
		lineageTag: d01f0458-5fb2-4469-80d7-1ed68b5077f3

	/// Total downtime minutes visible only for the top N operators by downtime
	measure 'Top N Operator Downtime' =
			
			VAR _n =
			    SELECTEDVALUE ( 'Top N'[Top N], 5 )
			RETURN
			    IF ( [Operator Downtime Rank] <= _n, [Total Downtime Minutes], BLANK () )
		formatString: #,##0
		displayFolder: 🔢 Ranking
		lineageTag: 5912e8b2-146f-4ba4-83fc-1994320e3b13

	/// Inline KPI direction icon (up=green, down=red, neutral=gray) based on Batch Efficiency % change
	measure 'Efficiency Status Icon' =
			
			VAR _eff = [Batch Efficiency %]
			VAR _up = "data:image/svg+xml;base64,PCEtLSBrcGktdXAuc3ZnIOKAlCBwb3NpdGl2ZSBLUEkgZGlyZWN0aW9uOiBncmVlbiB1cHdhcmQgdHJpYW5nbGUgLS0+DQo8c3ZnIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyIgdmlld0JveD0iMCAwIDI0IDI0Ij4NCiAgPHBhdGggZD0iTTEyIDVMMjAgMTlINEwxMiA1WiIgZmlsbD0iIzEwN0MxMCIvPg0KPC9zdmc+DQo="
			VAR _down = "data:image/svg+xml;base64,PCEtLSBrcGktZG93bi5zdmcg4oCUIG5lZ2F0aXZlIEtQSSBkaXJlY3Rpb246IHJlZCBkb3dud2FyZCB0cmlhbmdsZSAtLT4NCjxzdmcgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIiB2aWV3Qm94PSIwIDAgMjQgMjQiPg0KICA8cGF0aCBkPSJNMTIgMTlMNCA1SDIwTDEyIDE5WiIgZmlsbD0iI0E0MjYyQyIvPg0KPC9zdmc+DQo="
			VAR _flat = "data:image/svg+xml;base64,PCEtLSBrcGktbmV1dHJhbC5zdmcg4oCUIGZsYXQvbmV1dHJhbCBLUEkgZGlyZWN0aW9uOiBncmF5IGRhc2ggLS0+DQo8c3ZnIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyIgdmlld0JveD0iMCAwIDI0IDI0Ij4NCiAgPHJlY3QgeD0iNCIgeT0iMTAiIHdpZHRoPSIxNiIgaGVpZ2h0PSI0IiByeD0iMiIgZmlsbD0iIzYwNUU1QyIvPg0KPC9zdmc+DQo="
			RETURN
			    SWITCH ( TRUE (), _eff >= 0.90, _up, _eff >= 0.75, _flat, _down )
		displayFolder: 🔧 Utility
		lineageTag: 53d09648-7a0b-4528-ab04-b18d1552a0c6
		dataCategory: ImageUrl

	/// This operator-error factor's share of the operator's total operator-error downtime. Use in a matrix filtered to Operator Error = Yes to show which error types each operator is disproportionately responsible for.
	measure 'Operator Error Factor Share %' =
			
			DIVIDE (
			    [Total Downtime Minutes],
			    CALCULATE (
			        [Total Downtime Minutes],
			        ALL ( Dim_DowntimeFactor ),
			        Dim_DowntimeFactor[Operator Error] = "Yes"
			    ),
			    0
			)
		formatString: #,##0.0%
		displayFolder: 📈 Rates & Ratios
		lineageTag: 89e01257-de4a-476d-a28b-fe91ea6d4a36

	/// Sentiment color for positive KPIs (efficiency, savings). Bind to card background or accent bar via conditional formatting.
	measure 'Sentiment Color Positive' =
			
			"#34A85A"
		displayFolder: 🎨 Styling
		lineageTag: 11111111-1111-1111-1111-111111110001
		dataCategory: HexColor

	/// Sentiment color for negative KPIs (downtime, errors, cost). Bind to card background or accent bar via conditional formatting.
	measure 'Sentiment Color Negative' =
			
			"#A4262C"
		displayFolder: 🎨 Styling
		lineageTag: 11111111-1111-1111-1111-111111110002
		dataCategory: HexColor

	/// Sentiment color for neutral KPIs (counts, identifiers).
	measure 'Sentiment Color Neutral' =
			
			"#605E5C"
		displayFolder: 🎨 Styling
		lineageTag: 11111111-1111-1111-1111-111111110003
		dataCategory: HexColor

	/// Banded color for Batch Efficiency %: red < 60%, amber 60–75%, green ≥ 75%. Bind to background of Eff% cells / cards.
	measure 'Efficiency Band Color' =
			
			SWITCH (
			    TRUE (),
			    [Batch Efficiency %] < 0.50, "#A4262C",   -- Severe inefficiency
			    [Batch Efficiency %] < 0.70, "#D13438",   -- Significant delays
			    [Batch Efficiency %] < 0.80, "#C19C00",   -- Moderate delays
			    [Batch Efficiency %] < 0.90, "#92C353",   -- Very efficient
			    "#34A85A"                                 -- Excellent / near perfect
			)
		displayFolder: 🎨 Styling
		lineageTag: 11111111-1111-1111-1111-111111110004
		dataCategory: HexColor

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Color for Operator Error rows in mixed bar charts: red if Yes, green if No. Use as "Color by category" rule.
	measure 'Operator Error Color' =
			
			SWITCH (
			    SELECTEDVALUE ( Dim_DowntimeFactor[Operator Error] ),
			    "Yes", "#A4262C",
			    "No", "#34A85A",
			    "#605E5C"
			)
		displayFolder: 🎨 Styling
		lineageTag: 11111111-1111-1111-1111-111111110005
		dataCategory: HexColor

	measure 'Target Efficiency % Value' =
			
			DIVIDE (
			    SELECTEDVALUE ( 'Target Efficiency %'[Target Efficiency %], 85 ),
			    100,
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ⚙️ What-If
		lineageTag: 81c285cd-e455-40e4-b094-1504e724b9ce

	measure 'Downtime Reduction % Value' =
			
			DIVIDE (
			    SELECTEDVALUE ( 'Downtime Reduction %'[Downtime Reduction %], 25 ),
			    100,
			    0
			)
		formatString: 0%;-0%;0%
		displayFolder: ⚙️ What-If
		lineageTag: ef65c1aa-d287-4859-b020-c17c35876807

	measure 'Downtime Cost Per Hour Value' =
			
			SELECTEDVALUE ( 'Downtime Cost Per Hour'[Downtime Cost Per Hour], 150 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: ⚙️ What-If
		lineageTag: cc1cac2e-6239-4eee-801f-0288be1cf6bc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Simulated Downtime Minutes' =
			
			[Total Downtime Minutes] - ( [Operator Error Downtime Minutes] * [Downtime Reduction % Value] )
		displayFolder: ⚙️ What-If
		lineageTag: 50b1903e-dd80-4d08-8ace-484d4cc2f28e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulated Actual Duration Minutes' =
			
			[Total Actual Duration Minutes] - ( [Operator Error Downtime Minutes] * [Downtime Reduction % Value] )
		displayFolder: ⚙️ What-If
		lineageTag: 6050df03-e36e-42ba-a46e-db787edcd7b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulated Batch Efficiency %' =
			
			DIVIDE ( [Total Min Batch Time], [Simulated Actual Duration Minutes], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ⚙️ What-If
		lineageTag: d075b859-3a58-46c3-823b-4c5003b63dc6

	measure 'Efficiency Gap To Target %' =
			
			[Simulated Batch Efficiency %] - [Target Efficiency % Value]
		formatString: 0%;-0%;0%
		displayFolder: ⚙️ What-If
		lineageTag: ad639c20-d2a2-4339-a587-670fa13914b1

	measure 'Downtime Hours Saved' =
			
			DIVIDE (
			    [Operator Error Downtime Minutes] * [Downtime Reduction % Value],
			    60,
			    0
			)
		displayFolder: ⚙️ What-If
		lineageTag: 8e9d4ecb-6fc8-45bb-ab64-ae6eac75312c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Downtime Cost Avoided' =
			
			[Downtime Hours Saved] * [Downtime Cost Per Hour Value]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: ⚙️ What-If
		lineageTag: ba62cf4f-007e-42cc-b501-8c999ced3896

	measure 'Residual Downtime Cost' =
			
			DIVIDE ( [Simulated Downtime Minutes], 60, 0 ) * [Downtime Cost Per Hour Value]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: ⚙️ What-If
		lineageTag: 3f2d7b94-86f0-473f-b994-464a57bbddf0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Min Value Gauge' =
			
			0
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ⚙️ What-If
		lineageTag: e9dd81a7-133d-4dca-828b-c3c303d2a265

	measure 'Max Value Gauge' =
			
			1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ⚙️ What-If
		lineageTag: a9bfe91d-d1f6-49bc-9e6f-8aadc00ff795

	measure 'Total Downtime Cost' =
			
			DIVIDE ( [Total Downtime Minutes], 60 ) * [Downtime Cost Per Hour Value]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: ⚙️ What-If
		lineageTag: a2b63b51-1f39-4003-84fe-6a69cda2139e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Reduction' =
			
			[Total Downtime Cost] - [Residual Downtime Cost]
		displayFolder: ⚙️ What-If
		lineageTag: 305d58b7-573a-43ed-abda-2cdfd4c69231

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Waterfall Value' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Scenario Steps'[Step] ),
			    "Current Total Cost", [Total Downtime Cost],
			    "Cost Avoided", - [Downtime Cost Avoided],
			    "Residual Cost", [Residual Downtime Cost],
			    "Net Reduction", [Net Reduction]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: ⚙️ What-If
		lineageTag: ec1e8905-3be5-4acc-96bb-293b10d78979

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Simulated Efficiency Band Color' =
			
			SWITCH (
			    TRUE (),
			    [Simulated Batch Efficiency %] < 0.60, "#A4262C",
			    [Simulated Batch Efficiency %] < 0.75, "#C19C00",
			    "#34A85A"
			)
		displayFolder: 🎨 Styling
		lineageTag: a0991fdd-1a42-4d51-86a7-9a0591ab4990

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MinDate =
			
			MIN ( Dim_Date[Date] )
		displayFolder: Paginated Report Visual
		lineageTag: 795bd5f6-65ad-4bc6-9fc3-faef86d3800c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MaxDate =
			
			MAX ( Dim_Date[Date] )
		displayFolder: Paginated Report Visual
		lineageTag: 373305ef-081c-42f4-846f-d16c01883fdc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top N Download Error Value' =
			
			"Top " & SELECTEDVALUE ( 'Top N'[Top N], 5 ) & " Downtime Errors"
		displayFolder: 🔢 Ranking
		lineageTag: f59da270-5215-4936-965a-1e5d27fe73a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Downtime by Top N Operators' =
			
			"Downtime by Top " & SELECTEDVALUE ( 'Top N'[Top N] ) & " Operators"
		displayFolder: 🔢 Ranking
		lineageTag: 05287944-2a71-46d2-91a1-d1d0103e27cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Batches by Top N Operators' =
			
			"Batches by Top " & SELECTEDVALUE ( 'Top N'[Top N] ) & " Operators"
		displayFolder: 🔢 Ranking
		lineageTag: b31483ec-2d3b-437f-92f6-90f191b6e950

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operator Batch Rank' =
			
			RANKX ( ALL ( Dim_Operator[Operator] ), [Total Batches],, DESC, DENSE )
		displayFolder: 🔢 Ranking
		lineageTag: cadfda0f-78b4-486d-860e-290bcaaa2081

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top N Operator Batch' =
			
			VAR _n =
			    SELECTEDVALUE ( 'Top N'[Top N], 5 )
			RETURN
			    IF ( [Operator Batch Rank] <= _n, [Total Batches], BLANK () )
		formatString: 0
		displayFolder: 🔢 Ranking
		lineageTag: 16106f8b-0385-4efc-8a13-3508581fcbf4

		annotation PBI_FormatHint = {"isDecimal":true}

	column _
		isHidden
		lineageTag: 73ffbb9c-a638-4650-9eca-c8dd35571def
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = DATATABLE("_", INTEGER, {{0}})

