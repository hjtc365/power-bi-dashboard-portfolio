expression Raw_LineDowntime =
		let
		    Source          = Excel.Workbook(File.Contents("C:\\Dev\\power-bi-dashboard-portfolio\\dashboards\\manufacturing-downtime\\datasets\\Manufacturing_Line_Productivity.xlsx"), null, false),
		    Sheet           = Source{[Item="Line downtime",Kind="Sheet"]}[Data],
		    // Row 0: (blank, Downtime factor, blank...)
		    // Row 1: (Batch, 1, 2, ..., 12)
		    // Row 2+: actual data
		    SkipLabelRow    = Table.Skip(Sheet, 1),
		    Promoted        = Table.PromoteHeaders(SkipLabelRow, [PromoteAllScalars=true]),
		    // Rename columns by position: first = Batch, rest = 1..12
		    AllCols         = Table.ColumnNames(Promoted),
		    RenameList      = List.Transform(List.Positions(AllCols), each
		                          if _ = 0 then {AllCols{_}, "Batch"}
		                          else {AllCols{_}, Text.From(_)}),
		    Renamed         = Table.RenameColumns(Promoted, RenameList),
		    TypedBatch      = Table.TransformColumnTypes(Renamed, {{"Batch", Int64.Type}})
		in
		    TypedBatch
	lineageTag: 32ffaec0-acc9-4e22-abb0-88999893b92c
	queryGroup: '📥 Staging'

