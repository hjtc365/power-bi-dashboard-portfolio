  <DataSets>
    <DataSet Name="dsTopNList">
      <Query>
        <DataSourceName>MyWorkspace_manufacturing_downtime_analysis</DataSourceName>
        <CommandText>EVALUATE
SELECTCOLUMNS(
    GENERATESERIES(1, 20, 1),
    "Value", [Value]
)
ORDER BY [Value]</CommandText>
      </Query>
      <Fields>
        <Field Name="TopN_Value">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Value]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsOperatorList">
      <Query>
        <DataSourceName>MyWorkspace_manufacturing_downtime_analysis</DataSourceName>
        <CommandText>EVALUATE
SELECTCOLUMNS(
    VALUES(Dim_Operator[Operator]),
    "Operator", Dim_Operator[Operator]
)
ORDER BY [Operator]</CommandText>
      </Query>
      <Fields>
        <Field Name="Operator">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Operator]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsProductivityDetail">
      <Query>
        <DataSourceName>MyWorkspace_manufacturing_downtime_analysis</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="pStartDate">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pStartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pEndDate">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pEndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pProduct">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pProduct.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pOperator">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pOperator.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    Dim_Date[Date],
    Dim_Product[Product],
    Dim_Product[Flavor],
    Dim_Product[Size],
    Dim_Operator[Operator],
    FILTER(
        ALL(Dim_Date[Date]),
        Dim_Date[Date] &gt;= @pStartDate &amp;&amp;
        Dim_Date[Date] &lt;= @pEndDate
    ),
    RSCustomDaxFilter(@pProduct,EqualToCondition,[Dim_Product].[Product],String),
    RSCustomDaxFilter(@pOperator,EqualToCondition,[Dim_Operator].[Operator],String),
    "Actual Duration (min)",  [Total Actual Duration Minutes],
    "Target Duration (min)",  [Total Min Batch Time],
    "Efficiency (%)",         [Batch Efficiency %]
)</CommandText>
      </Query>
      <Fields>
        <Field Name="Dim_Date_Date_">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Dim_Date[Date]</DataField>
        </Field>
        <Field Name="Dim_Product_Product_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Product[Product]</DataField>
        </Field>
        <Field Name="Dim_Product_Flavor_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Product[Flavor]</DataField>
        </Field>
        <Field Name="Dim_Product_Size_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Product[Size]</DataField>
        </Field>
        <Field Name="Dim_Operator_Operator_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Operator[Operator]</DataField>
        </Field>
        <Field Name="ID_Actual_Duration__min__">
          <rd:TypeName>System.Object</rd:TypeName>
          <DataField>[Actual Duration (min)]</DataField>
        </Field>
        <Field Name="ID_Target_Duration__min__">
          <rd:TypeName>System.Object</rd:TypeName>
          <DataField>[Target Duration (min)]</DataField>
        </Field>
        <Field Name="ID_Efficiency_____">
          <rd:TypeName>System.Object</rd:TypeName>
          <DataField>[Efficiency (%)]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsProductList">
      <Query>
        <DataSourceName>MyWorkspace_manufacturing_downtime_analysis</DataSourceName>
        <CommandText>EVALUATE
SELECTCOLUMNS(
    ADDCOLUMNS(
        SUMMARIZE(
            Dim_Product,
            Dim_Product[Product],
            Dim_Product[Flavor],
            Dim_Product[Size]
        ),
        "ProductFlavorSize",
            Dim_Product[Product] &amp; " (" &amp;
            Dim_Product[Flavor] &amp; " - " &amp;
            Dim_Product[Size] &amp; ")"
    ),
    "Product", Dim_Product[Product],
    "ProductFlavorSize", [ProductFlavorSize]
)
ORDER BY
    [Product]</CommandText>
      </Query>
      <Fields>
        <Field Name="ID_Product_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Product]</DataField>
        </Field>
        <Field Name="ID_ProductFlavorSize_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[ProductFlavorSize]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsErrorTypeList">
      <Query>
        <DataSourceName>MyWorkspace_manufacturing_downtime_analysis</DataSourceName>
        <CommandText>EVALUATE
UNION(
    ROW(
        "ErrorTypeValue", "Both",
        "ErrorTypeLabel", "Both"
    ),
    SELECTCOLUMNS(
        VALUES(Dim_DowntimeFactor[Operator Error]),
        "ErrorTypeValue", Dim_DowntimeFactor[Operator Error],
        "ErrorTypeLabel", IF(
            Dim_DowntimeFactor[Operator Error] = "Yes",
            "Operator Error",
            "Not Operator Error"
        )
    )
)
ORDER BY [ErrorTypeLabel]</CommandText>
      </Query>
      <Fields>
        <Field Name="ID_ErrorTypeValue_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[ErrorTypeValue]</DataField>
        </Field>
        <Field Name="ID_ErrorTypeLabel_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[ErrorTypeLabel]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDowntimeDetails">
      <Query>
        <DataSourceName>MyWorkspace_manufacturing_downtime_analysis</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="pStartDate">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pStartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pEndDate">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pEndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pProduct">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pProduct.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pOperator">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pOperator.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pErrorType">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pErrorType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    Dim_Date[Date],
    Dim_Product[Product],
    Dim_Product[Flavor],
    Dim_Product[Size],
    Dim_Operator[Operator],
    Dim_DowntimeFactor[Operator Error],
    Dim_DowntimeFactor[Description],
    FILTER(
        ALL(Dim_Date[Date]),
        Dim_Date[Date] &gt;= @pStartDate &amp;&amp;
        Dim_Date[Date] &lt;= @pEndDate
    ),
    RSCustomDaxFilter(@pProduct,EqualToCondition,[Dim_Product].[Product],String),
    RSCustomDaxFilter(@pOperator,EqualToCondition,[Dim_Operator].[Operator],String),
    FILTER(
        ALL(Dim_DowntimeFactor[Operator Error]),
        @pErrorType = "Both"
            || Dim_DowntimeFactor[Operator Error] = @pErrorType
    ),
    "Downtime (min)",         [Total Downtime Minutes]
)</CommandText>
      </Query>
      <Fields>
        <Field Name="Dim_Date_Date_">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Dim_Date[Date]</DataField>
        </Field>
        <Field Name="Dim_Product_Product_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Product[Product]</DataField>
        </Field>
        <Field Name="Dim_Product_Flavor_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Product[Flavor]</DataField>
        </Field>
        <Field Name="Dim_Product_Size_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Product[Size]</DataField>
        </Field>
        <Field Name="Dim_Operator_Operator_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_Operator[Operator]</DataField>
        </Field>
        <Field Name="Dim_DowntimeFactor_Operator_Error_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_DowntimeFactor[Operator Error]</DataField>
        </Field>
        <Field Name="Dim_DowntimeFactor_Description_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dim_DowntimeFactor[Description]</DataField>
        </Field>
        <Field Name="ID_Downtime__min__">
          <rd:TypeName>System.Object</rd:TypeName>
          <DataField>[Downtime (min)]</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
