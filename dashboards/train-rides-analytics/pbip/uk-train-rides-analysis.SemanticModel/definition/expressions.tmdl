/// Shared staging source — loads and types the raw railway CSV. Referenced by all dimension and fact tables.
expression RailwayData =
		let
		    Source = Csv.Document(
		        File.Contents("C:\\Dev\\power-bi-dashboard-portfolio\\dashboards\\train-rides-analytics\\datasets\\railway.csv"),
		        [Delimiter = ",", Columns = 18, Encoding = 65001, QuoteStyle = QuoteStyle.None]
		    ),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    TypedCols = Table.TransformColumnTypes(PromotedHeaders, {
		        {"Transaction ID", type text},
		        {"Date of Purchase", type date},
		        {"Time of Purchase", type time},
		        {"Purchase Type", type text},
		        {"Payment Method", type text},
		        {"Railcard", type text},
		        {"Ticket Class", type text},
		        {"Ticket Type", type text},
		        {"Price", Int64.Type},
		        {"Departure Station", type text},
		        {"Arrival Destination", type text},
		        {"Date of Journey", type date},
		        {"Departure Time", type time},
		        {"Arrival Time", type time},
		        {"Actual Arrival Time", type text},
		        {"Journey Status", type text},
		        {"Reason for Delay", type text},
		        {"Refund Request", type text}
		    }),
		    CleanReason = Table.TransformColumns(TypedCols, {
		        {"Reason for Delay", each if _ = "" then null else _, type text}
		    })
		in
		    CleanReason
	lineageTag: c02cac41-0c83-4df2-86e2-6becdc3a69d7

