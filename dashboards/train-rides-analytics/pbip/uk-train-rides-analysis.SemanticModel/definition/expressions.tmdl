/// Shared staging source — loads and types the raw railway CSV. Referenced by all dimension and fact tables.
expression RailwayData =
		let
		    Source = Files,
		    #"RrailwayCSV" = Source{[#"Folder Path"="C:\Dev\power-bi-dashboard-portfolio\dashboards\train-rides-analytics\datasets\",Name="railway.csv"]}[Content],
		    #"Imported CSV" = Csv.Document(#"RrailwayCSV",[Delimiter=",", Columns=18, Encoding=1252, QuoteStyle=QuoteStyle.None]),
		    #"Promoted Headers" = Table.PromoteHeaders(#"Imported CSV", [PromoteAllScalars=true]),
		    CleanReason = Table.TransformColumns(#"Promoted Headers", {
		        {"Reason for Delay", each if _ = "" then null else _, type text}
		    })
		in
		    CleanReason
